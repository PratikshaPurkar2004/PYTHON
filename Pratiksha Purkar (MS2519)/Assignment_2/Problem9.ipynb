   "source": [
    "\n",
    "set1=set(map(int,input(\"Enter a first set of numbers::\").split()))\n",
    "print(set1)\n",
    "set2=set(map(int,input(\"Enter a second set of numbers::\").split()))\n",
    "print(set2)\n",
    "\n",
    "print(set1.union(set2))\n",
    "print(set1.intersection(set2))\n",
    "print(set1.difference(set2))\n",
    "print(set1.symmetric_difference(set2))"
   ]
  }
