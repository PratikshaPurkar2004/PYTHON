   "source": [
    "list1=[]\n",
    "for i in range(5):\n",
    "    num=int(input(\"Enter a number::\"))\n",
    "    list1.append(num)\n",
    "print(list1)\n",
    "even=[]\n",
    "odd=[]\n",
    "for i in list1:\n",
    "    if i%2==0:\n",
    "        even.append(i)\n",
    "    else:\n",
    "        odd.append(i)\n",
    "print(\"Even List::\",even)\n",
    "print(\"Odd List::\",odd)"
   ]
  }
