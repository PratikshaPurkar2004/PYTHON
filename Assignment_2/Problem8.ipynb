   "source": [
    "str=input(\"Enter a string::\")\n",
    "print(str)\n",
    "frequency={}\n",
    "for ch in str:\n",
    "    if ch in frequency:\n",
    "        frequency[ch]+=1\n",
    "    else:\n",
    "        frequency[ch]=1\n",
    "for ch,count in frequency.items():\n",
    "    print(ch,\":\",count)\n"
   ]
  }
